{
  "name": "epic-helper",
  "version": "1.0.0",
  "private": true,
  "description": "An unofficial Discord EPIC RPG helper bot",
  "homepage": "https://github.com/pwkang/epic-helper#readme",
  "bugs": {
    "url": "https://github.com/pwkang/epic-helper/issues"
  },
  "author": "whigon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwkang/epic-helper.git"
  },
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "main": "dist/index.js",
  "scripts": {
    "dev:bot": "nodemon --exec ts-node --files apps/bot/src/bot.ts --watch apps/bot",
    "dev:api": "nodemon --exec ts-node --files apps/api/src/index.ts --watch apps/api",
    "clean:node_modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find . -name \"dist\" -type d -prune -exec rm -rf '{}' +",
    "clean:cache": "vp cache clean",
    "clean:all": "npm run clean:node_modules && npm run clean:dist && npm run clean:cache",
    "build:shared": "vp run -r --cache build:shared",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "build:bot": "vp run -r --cache build:shared && vp run -r --cache build:bot",
    "build:api": "vp run -r --cache build:shared && vp run -r --cache build:api",
    "lint": "vp lint",
    "type-check": "vp run -r type-check",
    "dev-shard:bot": "npm run build:bot && USE_PINO_PRETTY=true node apps/bot/dist/index.js",
    "start:bot": "node apps/bot/dist/index.js",
    "prod:bot": "pm2 start ecosystem.config.js --only epic-helper",
    "prod:api": "pm2 start ecosystem.config.js --only epic-helper-api"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "contentful": "^11.12.10",
    "dayjs": "^1.11.23",
    "discord-hybrid-sharding": "^3.0.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "fuse.js": "^7.5.0",
    "json-bigint": "^1.0.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.12.0",
    "mongoose-lean-defaults": "^2.3.1",
    "ms": "^2.1.3",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/json-bigint": "^1.0.4",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.6",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite-plus": "^1.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.18.0"
}
